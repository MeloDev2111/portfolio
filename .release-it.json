{
    "git": {
        "commitMessage": "chore: release v${version} [skip ci]",
        "tagName": "v${version}",
        "push": true,
        "requireCleanWorkingDir": false,
        "requireBranch": "master"
    },
    "github": {
        "release": false
    },
    "hooks": {
        "after:release": "node scripts/sync-changelog.mjs ${version}"
    },
    "npm": {
        "publish": false
    },
    "plugins": {
        "@release-it/conventional-changelog": {
            "preset": "angular",
            "infile": false
        }
    }
}
