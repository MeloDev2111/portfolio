---
// DEMO route for the experience redesign proposals (not part of the final site).
import { getI18nStaticPaths } from "../../../i18n/utils";
import Layout from "../../../layouts/Layout.astro";
import VariantA from "../../../components/astro/experience-demo/VariantA.astro";
import VariantB from "../../../components/astro/experience-demo/VariantB.astro";
import VariantC from "../../../components/astro/experience-demo/VariantC.astro";

export function getStaticPaths() {
    return getI18nStaticPaths().flatMap(({ params }) =>
        ["a", "b", "c"].map((variant) => ({
            params: { ...params, variant },
        })),
    );
}

const { lang, variant } = Astro.params;
const es = lang === "es";
const names: Record<string, string> = {
    a: es ? "A · Línea de tiempo agrupada" : "A · Grouped timeline",
    b: es ? "B · Caso de estudio" : "B · Case study",
    c: es ? "C · Panel de impacto" : "C · Impact dashboard",
};
---

<Layout title={`Experience demo ${variant} | MeloDev`} lang={lang} noindex>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <nav class="mb-8 flex flex-wrap gap-2 text-sm" aria-label="Variants">
            {
                Object.entries(names).map(([key, label]) => (
                    <a
                        href={`/${lang}/experience-demo/${key}`}
                        aria-current={key === variant ? "page" : undefined}
                        class={`px-3 py-1.5 rounded-full border ${key === variant ? "bg-moon text-gunmetal border-moon font-semibold" : "border-white/15 text-[#c5cbd6] hover:border-moon/50"}`}
                    >
                        {label}
                    </a>
                ))
            }
        </nav>

        <h1 class="text-4xl md:text-5xl font-heading font-bold text-light mb-3">
            <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-moon to-white"
            >
                {es ? "Experiencia" : "Experience"}
            </span>
        </h1>
        <p class="text-lg text-[#a3a3ad] max-w-2xl mb-12">
            {es ? "Trayectoria e impacto" : "Work history & impact"}
        </p>

        {variant === "a" && <VariantA lang={lang} />}
        {variant === "b" && <VariantB lang={lang} />}
        {variant === "c" && <VariantC lang={lang} />}
    </div>
</Layout>
