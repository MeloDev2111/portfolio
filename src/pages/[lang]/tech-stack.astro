---
import { getI18nStaticPaths } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import TechStackComponent from "../../components/astro/TechStack.astro";
import { useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
    return getI18nStaticPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
---

<Layout
    title={`Portfolio | ${t("nav.tech")}`}
    lang={lang}
    description={t("page.techStackDescription")}
>
    <Section width="full" space="lg" backdrop="bloom">
        <PageHeader
            title={t("page.techStackTitle")}
            description={t("page.techStackDescription")}
            class="items-center text-center"
        />

        <TechStackComponent />
    </Section>
</Layout>
