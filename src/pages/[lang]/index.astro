---
import { getI18nStaticPaths } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/astro/Hero.astro";
import Experience from "../../components/astro/Experience.astro";
import Projects from "../../components/astro/Projects.astro";
import Section from "../../components/ui/Section.astro";
import ProofBar from "../../components/ui/ProofBar.astro";
import CTASection from "../../components/ui/CTASection.astro";

export function getStaticPaths() {
    return getI18nStaticPaths();
}

const { lang } = Astro.params;
---

<Layout title="MeloDev Portfolio" lang={lang}>
    <Hero />
    <ProofBar />
    <Projects />
    <Section
        id="experience"
        tone="base"
        width="wide"
        space="md"
        backdrop="grid"
    >
        <Experience count={2} />
    </Section>
    <Section width="wide" space="md">
        <CTASection />
    </Section>
</Layout>
