---
import { getI18nStaticPaths } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/ui/Section.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import About from "../../components/astro/About.astro";
import ExperienceComponent from "../../components/astro/Experience.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
    return getI18nStaticPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
---

<Layout
    title={`Portfolio | ${t("nav.experience")}`}
    lang={lang}
    description={t("nav.experienceKey")}
>
    <Section width="full" space="lg">
        <PageHeader
            title={t("nav.experience")}
            description={t("nav.experienceKey")}
        />

        <About />

        <div class="mt-16">
            <ExperienceComponent showTitle={false} />
        </div>
    </Section>
</Layout>
