---
import { getI18nStaticPaths } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import ExperienceComponent from "../../components/astro/Experience.astro";
import { useTranslations } from "../../i18n/utils";
import { totalYears } from "../../utils/experience";

export async function getStaticPaths() {
    return getI18nStaticPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const years = t("experience.years").replace("{years}", String(totalYears()));
---

<Layout
    title={`${t("nav.experience")} | MeloDev`}
    lang={lang}
    description={t("nav.experienceKey")}
>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-light mb-3">
            <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-moon to-white"
            >
                {t("nav.experience")}
            </span>
        </h1>

        <p class="text-lg text-[#a3a3ad] max-w-2xl mb-12">
            {years} · {t("nav.experienceKey")}
        </p>

        <ExperienceComponent />
    </div>
</Layout>
