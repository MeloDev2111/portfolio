---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
    id="lang-toast"
    class="fixed top-24 right-4 z-[60] transform translate-x-[120%] transition-transform duration-500 ease-out max-w-sm w-full"
>
    <div
        class="bg-surface/90 backdrop-blur-xl border border-border-accent p-4 rounded-xl shadow-[0_0_20px_color-mix(in_oklab,var(--accent)_20%,transparent)] flex items-start gap-3 relative overflow-hidden"
    >
        <!-- Glow effect -->
        <div
            class="absolute inset-0 bg-gradient-to-r from-accent-surface to-transparent pointer-events-none"
        >
        </div>

        <!-- Icon -->
        <div class="text-accent mt-0.5 shrink-0">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 20 20"
                fill="currentColor"
            >
                <path
                    fill-rule="evenodd"
                    d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                    clip-rule="evenodd"></path>
            </svg>
        </div>

        <!-- Content -->
        <div class="flex-1 text-sm">
            <h4 class="font-bold text-fg-strong mb-1">{t("toast.title")}</h4>
            <p class="text-fg-muted leading-relaxed">
                {t("toast.prefix")}{" "}
                <span id="toast-lang" class="font-mono text-accent font-bold"
                ></span>{" "}
                {t("toast.suffix")}
            </p>
        </div>

        <!-- Close Button -->
        <button
            id="close-toast"
            class="text-fg-muted hover:text-fg-strong transition-colors shrink-0"
            aria-label={t("toast.title")}
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>
</div>

<script>
    // Same module-caching caveat as Header.astro: re-query and re-bind on
    // astro:page-load so the close button is never wired to a detached node.
    function initLanguageToast() {
        const toast = document.getElementById("lang-toast");
        const langSpan = document.getElementById("toast-lang");
        const closeBtn = document.getElementById("close-toast");
        if (!toast || !langSpan) return;

        function hideToast() {
            toast?.classList.add("translate-x-[120%]");
            // Clean up URL param without refreshing
            window.history.replaceState(
                {},
                document.title,
                window.location.pathname,
            );
        }

        if (closeBtn && closeBtn.dataset.bound !== "true") {
            closeBtn.dataset.bound = "true";
            closeBtn.addEventListener("click", hideToast);
        }

        const fallbackLang = new URLSearchParams(window.location.search).get(
            "lang_fallback",
        );
        if (!fallbackLang) return;

        // Get full language name using Intl.DisplayNames
        let langName = fallbackLang;
        try {
            const displayNames = new Intl.DisplayNames(["en"], {
                type: "language",
            });
            langName = displayNames.of(fallbackLang) || fallbackLang;
        } catch (e) {
            console.warn("Intl.DisplayNames not supported or invalid code", e);
        }

        langSpan.textContent = langName;

        // Show toast after a small delay
        setTimeout(() => {
            toast.classList.remove("translate-x-[120%]");
        }, 500);

        // Auto hide after 6 seconds
        setTimeout(hideToast, 6000);
    }

    initLanguageToast();
    document.addEventListener("astro:page-load", initLanguageToast);
</script>
