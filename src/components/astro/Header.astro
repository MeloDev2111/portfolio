---
import {
    getLangFromUrl,
    useTranslations,
    getRelativeLocaleUrl,
} from "../../i18n/utils";
import { siteConfig, nav } from "../../site.config";

import Logo from "./Logo.astro";
import LanguagePicker from "./LanguagePicker.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname.replace(/\/+$/, "");

const navItems = nav
    .filter((item) => item.enabled !== false)
    .map((item) => {
        const href = getRelativeLocaleUrl(lang, item.path);
        return {
            href,
            label: t(item.key as Parameters<typeof t>[0]),
            active: currentPath === href.replace(/\/+$/, ""),
        };
    });
---

<header
    class="fixed top-6 left-1/2 -translate-x-1/2 w-[95%] max-w-6xl z-50 transition-all duration-300 ease-in-out"
>
    <div class="flex justify-between items-center h-14 px-2">
        <!-- P1: Brand (Left) -->
        <a
            href={getRelativeLocaleUrl(lang, "")}
            class="pl-4 flex items-center gap-2 group"
            aria-label={siteConfig.name}
        >
            <div
                class="p-1.5 rounded-full bg-surface-raised border border-border group-hover:border-border-accent transition-colors"
            >
                <Logo width="24" height="24" variant="original" />
            </div>
            <span
                class="text-lg font-bold text-fg tracking-tight hidden sm:block"
            >
                {siteConfig.alias}<span class="text-accent">.</span>
            </span>
        </a>

        <!-- P2: Nav Pills (Center) -->
        <nav
            class="hidden md:flex items-center gap-1 bg-surface-raised/60 backdrop-blur-sm p-1 rounded-full border border-border shadow-inner"
        >
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        aria-current={item.active ? "page" : undefined}
                        class={`px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-300 ${
                            item.active
                                ? "bg-surface-raised text-fg-strong shadow-sm"
                                : "text-fg-muted hover:text-fg-strong hover:bg-surface-raised/60"
                        }`}
                    >
                        {item.label}
                    </a>
                ))
            }
        </nav>

        <!-- P3: Actions (Right) -->
        <div class="flex items-center gap-2 pr-2">
            <!-- Theme Toggle -->
            <ThemeToggle />

            <!-- Language Dropdown -->
            <LanguagePicker />

            <!-- Mobile Menu Toggle -->
            <button
                id="mobile-menu-btn"
                class="md:hidden flex items-center justify-center pointer-coarse:min-h-11 pointer-coarse:min-w-11 p-2 text-fg-muted hover:text-fg-strong focus:outline-none"
                aria-label={t("nav.menu")}
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-6 h-6"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Menu (Floating & Detached) -->
    <div
        id="mobile-menu-backdrop"
        class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden transition-opacity duration-300 opacity-0"
        aria-hidden="true"
    >
    </div>
    <div
        id="mobile-menu"
        class="hidden fixed top-20 left-4 right-4 z-50 transform transition-all duration-300 origin-top scale-95 opacity-0"
        role="dialog"
        aria-modal="true"
        aria-label={t("nav.menu")}
    >
        <nav
            class="bg-surface/90 backdrop-blur-2xl border border-border rounded-2xl overflow-hidden shadow-2xl p-2 flex flex-col gap-1 ring-1 ring-border"
        >
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        aria-current={item.active ? "page" : undefined}
                        class="px-4 py-3 rounded-xl text-base font-medium text-fg-muted hover:text-fg-strong hover:bg-surface-raised transition-colors flex items-center justify-between group"
                    >
                        {item.label}
                        <span class="opacity-0 group-hover:opacity-100 transition-opacity text-accent">
                            →
                        </span>
                    </a>
                ))
            }
        </nav>
    </div>
</header>

<script>
    const header = document.querySelector("header");
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileMenuBackdrop = document.getElementById("mobile-menu-backdrop");

    let lastScrollY = window.scrollY;

    function handleScroll() {
        const currentScrollY = window.scrollY;

        // 1. Smart Navbar Logic
        if (currentScrollY > lastScrollY && currentScrollY > 100) {
            header?.classList.add("-translate-y-[150%]", "opacity-0");
            closeMobileMenu(); // Ensure menu closes on scroll down
        } else {
            header?.classList.remove("-translate-y-[150%]", "opacity-0");
        }

        // 2. Backdrop Logic
        if (currentScrollY > 20) {
            header?.classList.add("bg-bg/80", "backdrop-blur-md");
        } else {
            header?.classList.remove("bg-bg/80", "backdrop-blur-md");
        }

        lastScrollY = currentScrollY;
    }

    // Mobile Menu Functions
    let lastFocusedElement: HTMLElement | null = null;

    function getFocusableMenuItems(): HTMLElement[] {
        if (!mobileMenu) return [];
        return Array.from(
            mobileMenu.querySelectorAll<HTMLElement>(
                "a[href], button:not([disabled])",
            ),
        );
    }

    function trapFocus(e: KeyboardEvent) {
        if (e.key === "Escape") {
            closeMobileMenu();
            return;
        }

        if (e.key !== "Tab") return;

        const focusable = getFocusableMenuItems();
        if (!focusable.length) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
        }
    }

    function openMobileMenu() {
        lastFocusedElement = document.activeElement as HTMLElement;

        mobileMenu?.classList.remove("hidden");
        mobileMenuBackdrop?.classList.remove("hidden");
        mobileMenuBtn?.setAttribute("aria-expanded", "true");

        // Small delay to allow display:block to apply before transition
        setTimeout(() => {
            mobileMenu?.classList.remove("scale-95", "opacity-0");
            mobileMenuBackdrop?.classList.remove("opacity-0");
            getFocusableMenuItems()[0]?.focus();
        }, 10);

        document.body.style.overflow = "hidden"; // Lock scroll
        document.addEventListener("keydown", trapFocus);
    }

    function closeMobileMenu() {
        if (mobileMenuBtn?.getAttribute("aria-expanded") !== "true") return;

        mobileMenu?.classList.add("scale-95", "opacity-0");
        mobileMenuBackdrop?.classList.add("opacity-0");
        mobileMenuBtn?.setAttribute("aria-expanded", "false");

        setTimeout(() => {
            mobileMenu?.classList.add("hidden");
            mobileMenuBackdrop?.classList.add("hidden");
        }, 300); // Matches transition duration

        document.body.style.overflow = ""; // Unlock scroll
        document.removeEventListener("keydown", trapFocus);
        lastFocusedElement?.focus();
    }

    // Event Listeners
    let ticking = false;
    window.addEventListener("scroll", () => {
        if (!ticking) {
            window.requestAnimationFrame(() => {
                handleScroll();
                ticking = false;
            });
            ticking = true;
        }
    });

    if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener("click", () => {
            if (mobileMenu.classList.contains("hidden")) {
                openMobileMenu();
            } else {
                closeMobileMenu();
            }
        });

        mobileMenuBackdrop?.addEventListener("click", closeMobileMenu);

        mobileMenu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMobileMenu);
        });
    }
</script>
