---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import {
    getLangFromUrl,
    useTranslations,
    getRelativeLocaleUrl,
    ui,
} from "../../i18n/utils";
import { siteConfig } from "../../site.config";
import { getCVDetails } from "../../utils/cv";
import { getBentoSkills } from "../../utils/skills";
import { getPrimarySocials } from "../../utils/social";
import { EXPERIENCE } from "../../utils/experience";
import { publicFileExists } from "../../utils/files";
import Section from "../ui/Section.astro";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { url: cvUrl, filename: cvFilename } = getCVDetails(lang);

// Data Fetching: Latest Certification
const allCerts = await getCollection("certifications");
const latestCert = allCerts
    .filter((c) => c.data.starred)
    .sort(
        (a, b) =>
            new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
    )
    .at(0);

// Official Logos for the Bento (Centralized)
const techLogos = getBentoSkills().map((skill) => ({
    label: skill.name,
    src: skill.icon,
    brand: skill.featured?.brand,
}));

const currentJob = EXPERIENCE.find((job) => job.current);
---

<Section id="hero" tone="base" width="wide" space="lg" backdrop="grid">
    <div
        class="grid grid-cols-1 md:grid-cols-4 gap-4 auto-rows-[minmax(180px,auto)]"
    >
        <!-- 1. Main Identity Card -->
        <Card
            variant="glass"
            radius="bento"
            pad="lg"
            glow
            noise
            class="md:col-span-2 md:row-span-2 flex flex-col justify-between min-h-[320px] group"
        >
            <!-- Decorative Blob -->
            <div class="bloom -top-20 -right-20 h-64 w-64"></div>

            <div class="relative z-10 pt-4">
                <span
                    class="text-action-text font-mono text-base mb-2 block tracking-widest font-bold"
                >
                    {t("hero.greeting") || "Hi, I'm"}
                </span>
                <h1
                    class="font-heading text-5xl sm:text-6xl lg:text-7xl font-bold text-fg-strong mb-6 tracking-tight leading-tight"
                >
                    {siteConfig.name}
                </h1>
                <p
                    class="text-fg-muted text-lg sm:text-xl max-w-lg leading-relaxed font-light"
                >
                    {t("hero.description") || ui.en["hero.description"]}
                </p>
            </div>

            <div class="mt-8 flex flex-wrap gap-4 relative z-10">
                <Button
                    href={cvUrl}
                    download={cvFilename}
                    external
                    variant="primary"
                    size="lg"
                    iconPosition="end"
                >
                    {t("hero.cta") || ui.en["hero.cta"]}
                    <svg
                        slot="icon"
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        stroke-width="2.5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                        ></path>
                    </svg>
                </Button>
                <Button
                    href={getPrimarySocials().find((s) => s.name === "LinkedIn")
                        ?.url}
                    external
                    variant="secondary"
                    size="lg"
                >
                    {t("nav.contact")}
                </Button>
            </div>
        </Card>

        <!-- 2. Currently (role + company + core stack) -->
        <Card
            as="a"
            href={getRelativeLocaleUrl(lang, "/experience")}
            variant="glass"
            radius="bento"
            pad="sm"
            interactive
            noise
            class="md:col-span-2 md:row-span-1 flex flex-col justify-center gap-4 group"
        >
            <div class="flex items-center justify-between relative z-10">
                <p
                    class="text-[10px] text-fg-subtle font-mono uppercase tracking-widest font-medium"
                >
                    {t("hero.currentRole")}
                </p>
                <span class="relative flex h-2 w-2">
                    <span
                        class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-action opacity-75"
                    ></span>
                    <span
                        class="relative inline-flex rounded-full h-2 w-2 bg-action"
                    ></span>
                </span>
            </div>

            {
                currentJob && (
                    <div class="flex items-center gap-3 relative z-10">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 border border-border-strong bg-surface-raised">
                            {publicFileExists(currentJob.logo) ? (
                                <img
                                    src={currentJob.logo}
                                    alt={currentJob.company}
                                    class="w-full h-full object-contain p-1.5"
                                />
                            ) : (
                                <span class="text-accent font-bold text-sm">
                                    {currentJob.company.charAt(0)}
                                </span>
                            )}
                        </div>
                        <div>
                            <h4 class="text-sm font-bold leading-none text-fg group-hover:text-accent transition-colors">
                                {currentJob.role}
                            </h4>
                            <p class="text-[10px] text-fg-subtle mt-1 font-mono">
                                {currentJob.company}
                            </p>
                        </div>
                    </div>
                )
            }

            <div
                class="flex flex-wrap items-center gap-2 pt-3 border-t border-border relative z-10"
            >
                {
                    techLogos.slice(0, 6).map((tech) => (
                        <Image
                            src={tech.src}
                            alt={tech.label}
                            title={tech.label}
                            width={24}
                            height={24}
                            class="h-6 w-6 object-contain opacity-80 grayscale transition-all group-hover:grayscale-0 group-hover:opacity-100"
                        />
                    ))
                }
                <span class="ml-auto text-[10px] text-accent group-hover:text-fg-strong transition-colors">
                    {t("section.viewFullExperience")}
                </span>
            </div>
        </Card>

        <!-- 3. Proof (latest certification + socials) -->
        <Card
            variant="glass"
            radius="bento"
            pad="sm"
            glow
            noise
            class="md:col-span-2 md:row-span-1 flex items-center gap-4 group"
        >
            {
                latestCert && (
                    <a
                        href={getRelativeLocaleUrl(lang, "/certifications")}
                        class="flex flex-1 items-center gap-3 min-w-0"
                    >
                        <div class="w-12 h-12 flex-shrink-0 flex items-center justify-center">
                            {latestCert.data.badge ? (
                                <Image
                                    src={
                                        latestCert.data.badge.startsWith(
                                            "http",
                                        )
                                            ? latestCert.data.badge
                                            : import.meta.env.BASE_URL.replace(
                                                  /\/$/,
                                                  "",
                                              ) + latestCert.data.badge
                                    }
                                    alt={latestCert.data.name}
                                    width={48}
                                    height={48}
                                    class="w-full h-full object-contain"
                                    loading="eager"
                                />
                            ) : (
                                <span class="text-3xl">🏆</span>
                            )}
                        </div>
                        <div class="min-w-0">
                            <p class="text-[10px] text-action-text font-heading uppercase tracking-widest font-bold">
                                {t("hero.latestAchievement")}
                            </p>
                            <h3 class="text-sm font-bold text-fg-strong leading-tight truncate group-hover:text-accent transition-colors">
                                {latestCert.data.name}
                            </h3>
                        </div>
                    </a>
                )
            }

            <div class="flex items-center gap-2 border-l border-border pl-4 flex-shrink-0">
                {
                    getPrimarySocials().map((social) => (
                        <a
                            href={social.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={social.name}
                            class="w-9 h-9 flex items-center justify-center rounded-lg bg-surface-raised hover:bg-surface border border-border hover:border-border-accent text-fg p-2 transition-colors"
                            set:html={social.icon}
                        />
                    ))
                }
            </div>
        </Card>
    </div>
</Section>
