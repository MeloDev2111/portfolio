---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import {
    getLangFromUrl,
    useTranslations,
    getRelativeLocaleUrl,
    ui,
} from "../../i18n/utils";
import { siteConfig } from "../../site.config";
import { getCVDetails } from "../../utils/cv";
import { getBentoSkills } from "../../utils/skills";
import { getPrimarySocials, getSecondarySocials } from "../../utils/social";
import { EXPERIENCE } from "../../utils/experience";
import { publicFileExists } from "../../utils/files";
import Section from "../ui/Section.astro";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { url: cvUrl, filename: cvFilename } = getCVDetails(lang);

// Data Fetching: Latest Certification
const allCerts = await getCollection("certifications");
const latestCert = allCerts
    .filter((c) => c.data.starred)
    .sort(
        (a, b) =>
            new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
    )
    .at(0);

// Official Logos for the Bento (Centralized)
const techLogos = getBentoSkills().map((skill) => ({
    label: skill.name,
    src: skill.icon,
    brand: skill.featured?.brand,
}));
---

<Section id="hero" tone="base" width="wide" space="lg" backdrop="grid">
    <div
        class="grid grid-cols-1 md:grid-cols-4 gap-4 auto-rows-[minmax(180px,auto)]"
    >
        <!-- 1. Main Identity Card -->
        <Card
            variant="glass"
            radius="bento"
            pad="lg"
            glow
            noise
            class="md:col-span-2 md:row-span-2 flex flex-col justify-between min-h-[320px] group"
        >
            <!-- Decorative Blob -->
            <div class="bloom -top-20 -right-20 h-64 w-64"></div>

            <div class="relative z-10 pt-4">
                <span
                    class="text-action-text font-mono text-base mb-2 block tracking-widest font-bold"
                >
                    {t("hero.greeting") || "Hi, I'm"}
                </span>
                <h1
                    class="font-heading text-5xl sm:text-6xl lg:text-7xl font-bold text-fg-strong mb-6 tracking-tight leading-tight"
                >
                    {siteConfig.name}
                </h1>
                <p
                    class="text-fg-muted text-lg sm:text-xl max-w-lg leading-relaxed font-light"
                >
                    {t("hero.description") || ui.en["hero.description"]}
                </p>
            </div>

            <div class="mt-8 flex flex-wrap gap-4 relative z-10">
                <Button
                    href={cvUrl}
                    download={cvFilename}
                    external
                    variant="primary"
                    size="lg"
                    iconPosition="end"
                >
                    {t("hero.cta") || ui.en["hero.cta"]}
                    <svg
                        slot="icon"
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        stroke-width="2.5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                        ></path>
                    </svg>
                </Button>
                <Button
                    href={getPrimarySocials().find((s) => s.name === "LinkedIn")
                        ?.url}
                    external
                    variant="secondary"
                    size="lg"
                >
                    {t("nav.contact")}
                </Button>
            </div>
        </Card>

        <!-- 2. Main Socials (Compact Stack) -->
        <Card
            variant="glass"
            radius="bento"
            pad="sm"
            noise
            class="md:col-span-1 md:row-span-1 flex flex-col gap-3 justify-center group"
        >
            {
                getPrimarySocials().map((social) => (
                    <a
                        href={social.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-3 p-2.5 rounded-xl bg-surface-raised hover:bg-surface border border-border hover:border-border-accent transition-all group/link relative overflow-hidden"
                    >
                        <span
                            class="w-8 h-8 flex items-center justify-center rounded-lg bg-surface-sunken text-fg p-1.5 group-hover/link:scale-110 transition-transform"
                            set:html={social.icon}
                        />

                        <div class="flex flex-col">
                            <span class="text-xs font-bold text-fg group-hover/link:text-action-text transition-colors leading-tight">
                                {social.name}
                            </span>
                            <span class="text-[10px] text-fg-subtle font-medium leading-tight">
                                {social.label}
                            </span>
                        </div>
                        <div class="absolute right-2 text-fg-subtle opacity-0 group-hover/link:opacity-100 transition-opacity">
                            <svg
                                class="w-3 h-3"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M7 17L17 7M17 7H7M17 7V17"
                                />
                            </svg>
                        </div>
                    </a>
                ))
            }
        </Card>

        <!-- 3. Latest Certification (Dynamic) -->
        {
            latestCert && (
                <Card
                    as="a"
                    href="#certifications"
                    variant="glass"
                    radius="bento"
                    pad="sm"
                    interactive
                    glow
                    noise
                    class="md:col-span-1 md:row-span-1 flex flex-col items-center justify-between group"
                >
                    <div class="relative z-10 w-full flex flex-col items-center h-full">
                        <p class="text-[10px] text-action-text font-heading mb-2 text-center uppercase tracking-widest font-bold animate-pulse">
                            {t("hero.latestAchievement")}
                        </p>

                        <div class="flex-grow flex items-center justify-center py-2">
                            {latestCert.data.badge ? (
                                <div class="w-16 h-16 relative filter drop-shadow-[0_0_15px_color-mix(in_oklab,var(--accent)_20%,transparent)] group-hover:drop-shadow-[0_0_20px_color-mix(in_oklab,var(--accent)_40%,transparent)] group-hover:scale-110 transition-all duration-500 ease-out">
                                    <Image
                                        src={
                                            latestCert.data.badge.startsWith(
                                                "http",
                                            )
                                                ? latestCert.data.badge
                                                : import.meta.env.BASE_URL.replace(
                                                      /\/$/,
                                                      "",
                                                  ) + latestCert.data.badge
                                        }
                                        alt={latestCert.data.name}
                                        width={64}
                                        height={64}
                                        class="w-full h-full object-contain"
                                        loading="eager"
                                    />
                                </div>
                            ) : (
                                <span class="text-4xl group-hover:scale-110 transition-transform duration-500">
                                    🏆
                                </span>
                            )}
                        </div>

                        <div class="text-center mt-2 transform group-hover:-translate-y-1 transition-transform duration-500">
                            <h3 class="text-xs font-heading font-bold text-fg-strong leading-tight group-hover:text-accent transition-colors duration-300 line-clamp-2">
                                {latestCert.data.name}
                            </h3>
                            <p class="text-[10px] text-fg-subtle mt-1 group-hover:text-fg-muted transition-colors duration-300">
                                {latestCert.data.date}
                            </p>
                        </div>
                    </div>

                    {/* Arrow Indicator */}
                    <div class="absolute top-3 right-3 text-accent opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500 delay-100">
                        <svg
                            class="w-3 h-3"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M14 5l7 7m0 0l-7 7m7-7H3"
                            />
                        </svg>
                    </div>
                </Card>
            )
        }

        <!-- 4. Experience / Timeline Card (Dynamic) -->
        <Card
            as="a"
            href="#experience"
            variant="glass"
            radius="bento"
            pad="sm"
            interactive
            noise
            class="md:col-span-1 md:row-span-1 flex flex-col justify-between group"
        >
            <div class="flex items-center justify-between mb-2 relative z-10">
                <p
                    class="text-[10px] text-fg-subtle font-mono uppercase tracking-widest font-medium"
                >
                    {t("nav.experience")}
                </p>
                <div class="flex items-center gap-2">
                    <span class="relative flex h-2 w-2">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-action opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-2 w-2 bg-action"
                        ></span>
                    </span>
                </div>
            </div>

            <div
                class="relative z-10 flex-grow flex flex-col gap-3 justify-center"
            >
                {
                    EXPERIENCE.slice(0, 2).map((job) => (
                        <div
                            class={`flex items-center gap-3 ${!job.current ? "opacity-60 group-hover:opacity-100 transition-opacity duration-300" : ""}`}
                        >
                            <div
                                class={`w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 border border-border shadow-sm ${job.current ? "bg-surface-raised border-border-strong" : "bg-surface-raised"}`}
                            >
                                {publicFileExists(job.logo) ? (
                                    <img
                                        src={job.logo}
                                        alt={job.company}
                                        class="w-full h-full object-contain p-1.5"
                                    />
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center bg-surface-raised border border-border-strong rounded-lg text-accent font-bold text-sm">
                                        {job.company.charAt(0)}
                                    </div>
                                )}
                            </div>
                            <div>
                                <h4
                                    class={`text-sm font-bold leading-none ${job.current ? "text-fg group-hover:text-accent transition-colors" : "text-fg-muted font-medium"}`}
                                >
                                    {job.role.replace("Developer", "").trim()}
                                </h4>
                                <p class="text-[10px] text-fg-subtle mt-1 font-mono">
                                    {job.startDate} -{" "}
                                    {job.current
                                        ? t("ui.current")
                                        : job.endDate}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div
                class="relative z-10 mt-2 flex justify-end border-t border-border pt-2"
            >
                <span
                    class="text-[10px] text-accent group-hover:text-fg-strong transition-colors flex items-center gap-1 font-medium"
                >
                    {t("section.viewFullExperience")}
                    <span class="group-hover:translate-x-1 transition-transform"
                        >-></span
                    >
                </span>
            </div>
        </Card>

        <!-- 5. Tech Stack (Compact Grid) -->
        <Card
            variant="glass"
            radius="bento"
            pad="sm"
            noise
            class="md:col-span-1 md:row-span-1 flex flex-col group"
        >
            <div class="flex items-center justify-between mb-4 relative z-10">
                <p
                    class="text-[10px] text-fg-subtle font-mono uppercase tracking-widest font-medium"
                >
                    {t("nav.tech") || "Tech Stack"}
                </p>
                <a
                    href={getRelativeLocaleUrl(lang, "/tech-stack")}
                    class="text-[10px] text-accent hover:text-fg-strong transition-colors opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 transition-all duration-300"
                >
                    {t("section.viewFullTech")?.split(" ")[0] || "View"} ->
                </a>
            </div>

            <div class="grid grid-cols-4 gap-3 relative z-10 content-start">
                {
                    (() => {
                        const MAX_ICONS = 8;
                        const displayedSkills = techLogos.slice(
                            0,
                            MAX_ICONS - 1,
                        ); // Save 1 slot for "More" button
                        const remaining =
                            techLogos.length - displayedSkills.length;

                        return (
                            <>
                                {displayedSkills.map((tech) => (
                                    <div
                                        class="group/icon relative w-full aspect-square flex items-center justify-center p-2 rounded-lg border border-border bg-surface-raised group-hover/icon:border-[var(--brand)]/40 group-hover/icon:bg-[var(--brand)]/20 hover:scale-105 transition-transform cursor-default"
                                        style={
                                            tech.brand
                                                ? `--brand: ${tech.brand}`
                                                : undefined
                                        }
                                    >
                                        <Image
                                            src={tech.src}
                                            alt={tech.label}
                                            width={64}
                                            height={64}
                                            class="w-full h-full object-contain filter grayscale opacity-80 brightness-125 group-hover/icon:grayscale-0 group-hover/icon:opacity-100 group-hover/icon:brightness-100 transition-all duration-300"
                                        />

                                        {/* Dynamic Tooltip */}
                                        <div class="absolute -top-8 left-1/2 -translate-x-1/2 bg-surface-raised text-fg text-[10px] font-bold px-2 py-1 rounded-md opacity-0 group-hover/icon:opacity-100 transform translate-y-2 group-hover/icon:translate-y-0 transition-all duration-200 pointer-events-none whitespace-nowrap border border-border-strong shadow-xl z-20">
                                            {tech.label}
                                            <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-surface-raised border-r border-b border-border-strong rotate-45" />
                                        </div>
                                    </div>
                                ))}

                                {/* View All Link/Button */}
                                <a
                                    href={getRelativeLocaleUrl(
                                        lang,
                                        "/tech-stack",
                                    )}
                                    class="group/more relative w-full aspect-square flex items-center justify-center rounded-lg border border-border bg-surface-raised group-hover:bg-surface group-hover:border-border-accent hover:!bg-accent-surface hover:!border-accent transition-all cursor-pointer"
                                >
                                    <span class="text-xs font-bold text-fg-muted group-hover:text-fg group-hover/more:text-accent transition-colors">
                                        +{remaining}
                                    </span>

                                    {/* Dynamic Tooltip for +N */}
                                    <div class="absolute -top-8 left-1/2 -translate-x-1/2 bg-surface-raised text-fg text-[10px] font-bold px-2 py-1 rounded-md opacity-0 group-hover/more:opacity-100 transform translate-y-2 group-hover/more:translate-y-0 transition-all duration-200 pointer-events-none whitespace-nowrap border border-border-strong shadow-xl z-20">
                                        {t("ui.more") || "View All"}
                                        <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-surface-raised border-r border-b border-border-strong rotate-45" />
                                    </div>
                                </a>
                            </>
                        );
                    })()
                }
            </div>
        </Card>
    </div>
</Section>
