---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import {
    EXPERIENCE,
    boldMarkup,
    formatMonth,
    formatTenure,
    localize,
    localizeList,
    monthsBetween,
} from "../../utils/experience";
import { getCVDetails } from "../../utils/cv";
import { publicFileExists } from "../../utils/files";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { url: cvUrl, filename: cvFilename } = getCVDetails(lang);

const endLabel = (end: string) =>
    end === "Present" ? t("ui.current") : formatMonth(end, lang);
const tenure = (start: string, end: string) =>
    formatTenure(monthsBetween(start, end), lang);
---

<div class="relative text-left">
    <ol class="space-y-8 md:space-y-10">
        {
            EXPERIENCE.map((company) => {
                const first = company.roles[company.roles.length - 1];
                const last = company.roles[0];
                // One role: its own dates already say it all, so skip the company dates.
                const single = company.roles.length === 1;
                return (
                    <li>
                        <article class="glass-card rounded-2xl p-5 sm:p-7 lg:p-9">
                            <header class="flex items-center gap-4 pb-6 border-b border-white/10">
                                <div class="shrink-0 h-12 w-12 sm:h-14 sm:w-14 rounded-xl bg-[#f4f4f5] flex items-center justify-center p-2">
                                    {publicFileExists(company.logo) ? (
                                        <img
                                            src={company.logo}
                                            alt=""
                                            width="40"
                                            height="40"
                                            loading="lazy"
                                            decoding="async"
                                            class="max-h-full max-w-full object-contain"
                                        />
                                    ) : (
                                        <span
                                            class="font-heading text-xl font-bold text-gunmetal"
                                            aria-hidden="true"
                                        >
                                            {company.company.charAt(0)}
                                        </span>
                                    )}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h2 class="font-heading text-2xl md:text-3xl font-bold text-light leading-tight">
                                        {company.company}
                                    </h2>
                                    <p class="mt-0.5 text-sm md:text-base text-[#a3a3ad]">
                                        {localize(company.kind, lang)} ·{" "}
                                        {localize(company.location, lang)}
                                    </p>
                                </div>
                                {!single && (
                                    <p class="hidden sm:block text-sm font-mono text-[#a3a3ad] text-right shrink-0">
                                        <time datetime={first.start}>
                                            {formatMonth(first.start, lang)}
                                        </time>
                                        {" – "}
                                        {last.end === "Present" ? (
                                            endLabel(last.end)
                                        ) : (
                                            <time datetime={last.end}>
                                                {endLabel(last.end)}
                                            </time>
                                        )}
                                        <span class="block text-moon">
                                            {tenure(first.start, last.end)}
                                        </span>
                                    </p>
                                )}
                            </header>
                            {!single && (
                                <p class="sm:hidden mt-4 text-sm font-mono text-[#a3a3ad]">
                                    {formatMonth(first.start, lang)}
                                    {" – "}
                                    {endLabel(last.end)}
                                    <span class="text-moon">
                                        {" · "}
                                        {tenure(first.start, last.end)}
                                    </span>
                                </p>
                            )}

                            <ol class="mt-8 ml-1.5 border-l border-white/10 space-y-12">
                                {company.roles.map((role, i) => (
                                    <li class="relative pl-6 md:pl-9 grid gap-x-10 gap-y-4 lg:grid-cols-[250px_minmax(0,1fr)]">
                                        <span
                                            class={`absolute -left-[7px] top-2 h-3.5 w-3.5 rounded-full border-2 border-gunmetal ${i === 0 && role.end === "Present" ? "bg-moon" : "bg-wolf"}`}
                                            aria-hidden="true"
                                        />
                                        <div>
                                            <h3 class="font-heading text-lg md:text-xl font-semibold text-light leading-snug">
                                                {role.title}
                                            </h3>
                                            <p class="mt-1 text-sm font-mono text-[#a3a3ad]">
                                                <time datetime={role.start}>
                                                    {formatMonth(
                                                        role.start,
                                                        lang,
                                                    )}
                                                </time>
                                                {" – "}
                                                {role.end === "Present" ? (
                                                    endLabel(role.end)
                                                ) : (
                                                    <time datetime={role.end}>
                                                        {endLabel(role.end)}
                                                    </time>
                                                )}
                                                <span class="text-moon">
                                                    {" · "}
                                                    {tenure(
                                                        role.start,
                                                        role.end,
                                                    )}
                                                </span>
                                            </p>
                                            <p class="mt-3 text-sm leading-5">
                                                <span class="block text-[11px] font-semibold uppercase tracking-widest text-moon">
                                                    {t(
                                                        role.assignment.kind ===
                                                            "client"
                                                            ? "experience.client"
                                                            : "experience.project",
                                                    )}
                                                </span>
                                                <span class="text-[#c5cbd6]">
                                                    {localize(
                                                        role.assignment.value,
                                                        lang,
                                                    )}
                                                </span>
                                            </p>
                                            <ul class="mt-4 flex flex-wrap gap-2">
                                                {role.technologies.map(
                                                    (tech) => (
                                                        <li class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-xs font-mono text-[#c5cbd6]">
                                                            {tech}
                                                        </li>
                                                    ),
                                                )}
                                            </ul>
                                        </div>
                                        <div class="min-w-0">
                                            <p class="max-w-[68ch] text-base md:text-lg font-medium leading-7 text-light">
                                                {localize(role.summary, lang)}
                                            </p>
                                            <ul class="mt-4 space-y-3 max-w-[68ch] text-[15px] md:text-base leading-7 text-[#c5cbd6]">
                                                {localizeList(
                                                    role.highlights,
                                                    lang,
                                                ).map((highlight) => (
                                                    <li
                                                        class="relative pl-5 before:absolute before:left-0 before:top-[0.75em] before:h-1.5 before:w-1.5 before:rounded-full before:bg-moon/70"
                                                        set:html={boldMarkup(
                                                            highlight,
                                                        )}
                                                    />
                                                ))}
                                            </ul>
                                        </div>
                                    </li>
                                ))}
                            </ol>
                        </article>
                    </li>
                );
            })
        }
    </ol>

    <div class="mt-12 flex">
        <a
            href={cvUrl}
            download={cvFilename}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-8 py-3.5 rounded-xl bg-moon text-gunmetal font-bold hover:brightness-110 transition-all hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-moon/20"
        >
            <span>{t("hero.cta")}</span>
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                ></path>
            </svg>
        </a>
    </div>
</div>
