---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import Card from "../ui/Card.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const focusAreas = [
    {
        title: t("about.architecture.title"),
        subtitle: t("about.architecture.subtitle"),
        path: "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 01-2 2v4a2 2 0 012 2h14a2 2 0 002-2v-4a2 2 0 01-2-2m-2-4h.01M17 16h.01",
    },
    {
        title: t("about.cloud.title"),
        subtitle: t("about.cloud.subtitle"),
        path: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
    },
    {
        title: t("about.data.title"),
        subtitle: t("about.data.subtitle"),
        path: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
    },
];
---

<Card
    variant="glass"
    radius="panel"
    pad="lg"
    noise
    class="relative overflow-hidden"
>
    <div class="grid gap-12 md:grid-cols-3 relative z-10">
        <!-- Bio -->
        <div class="md:col-span-2 prose">
            <p set:html={t("about.p1")} />
            <p set:html={t("about.p2")} />
        </div>

        <!-- Focus Areas -->
        <div
            class="md:col-span-1 border-t md:border-t-0 md:border-l border-border pt-8 md:pt-0 md:pl-12 flex flex-col justify-center"
        >
            <h3
                class="text-sm font-bold text-fg-subtle uppercase tracking-widest mb-6 flex items-center gap-2"
            >
                <span class="w-2 h-2 rounded-full bg-accent"></span>
                {t("about.focusAreas")}
            </h3>

            <div class="flex flex-col gap-4">
                {
                    focusAreas.map((area) => (
                        <Card
                            variant="outline"
                            pad="sm"
                            radius="card"
                            class="hover:border-border-accent transition-all hover:-translate-x-1"
                        >
                            <div class="flex items-center gap-3 mb-1">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-5 h-5 text-accent"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d={area.path}
                                    />
                                </svg>
                                <span class="font-bold text-fg">
                                    {area.title}
                                </span>
                            </div>
                            <p class="text-xs text-fg-muted pl-8">
                                {area.subtitle}
                            </p>
                        </Card>
                    ))
                }
            </div>
        </div>
    </div>
</Card>
