---
// Proposal B: case-study layout. Sticky company summary (with key numbers) next to a readable column.
import {
    DEMO_EXPERIENCE,
    formatMonth,
    tenure,
} from "../../../utils/experience-demo";

interface Props {
    lang: string;
}
const { lang } = Astro.props;
const es = lang === "es";
const present = es ? "Actualidad" : "Present";
---

<div class="space-y-16 md:space-y-24">
    {
        DEMO_EXPERIENCE.map((c) => {
            const first = c.roles[c.roles.length - 1];
            const last = c.roles[0];
            return (
                <article class="grid lg:grid-cols-[300px_minmax(0,1fr)] gap-8 lg:gap-14">
                    <aside class="lg:sticky lg:top-24 self-start">
                        <div class="glass-card rounded-2xl p-6">
                            <div class="flex items-center gap-4">
                                <div class="shrink-0 w-12 h-12 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center">
                                    <span
                                        class="font-heading text-xl font-bold text-moon"
                                        aria-hidden="true"
                                    >
                                        {c.company.charAt(0)}
                                    </span>
                                </div>
                                <h2 class="font-heading text-2xl font-bold text-light">
                                    {c.company}
                                </h2>
                            </div>
                            <p class="mt-4 text-sm text-[#a3a3ad] leading-6">
                                {c.context[es ? "es" : "en"]}
                            </p>
                            <p class="mt-3 text-sm font-mono text-[#c5cbd6]">
                                <time datetime={first.start}>
                                    {formatMonth(first.start, lang)}
                                </time>
                                {" – "}
                                {last.end === "Present" ? (
                                    present
                                ) : (
                                    <time datetime={last.end}>
                                        {formatMonth(last.end, lang)}
                                    </time>
                                )}
                                <span class="text-moon">
                                    {" · "}
                                    {tenure(first.start, last.end, lang)}
                                </span>
                            </p>
                            <p class="text-sm text-[#a3a3ad]">
                                {c.location[es ? "es" : "en"]}
                            </p>

                            <dl class="mt-6 pt-6 border-t border-white/10 space-y-5">
                                {c.metrics.map((m) => (
                                    <div>
                                        <dd class="font-heading text-3xl font-bold text-moon leading-none">
                                            {m.value}
                                        </dd>
                                        <dt class="mt-1 text-sm text-[#a3a3ad]">
                                            {m.label[es ? "es" : "en"]}
                                        </dt>
                                    </div>
                                ))}
                            </dl>
                        </div>
                    </aside>

                    <div class="min-w-0 divide-y divide-white/10">
                        {c.roles.map((r, i) => (
                            <section class={i === 0 ? "pb-10" : "py-10"}>
                                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                                    <h3 class="font-heading text-xl md:text-2xl font-semibold text-light">
                                        {r.title}
                                    </h3>
                                    <p class="text-sm font-mono text-[#a3a3ad]">
                                        <time datetime={r.start}>
                                            {formatMonth(r.start, lang)}
                                        </time>
                                        {" – "}
                                        {r.end === "Present" ? (
                                            present
                                        ) : (
                                            <time datetime={r.end}>
                                                {formatMonth(r.end, lang)}
                                            </time>
                                        )}
                                    </p>
                                </div>
                                <ul class="mt-5 space-y-4 max-w-[68ch] text-base leading-7 text-[#c5cbd6]">
                                    {r.highlights[es ? "es" : "en"].map((h) => (
                                        <li class="relative pl-6 before:absolute before:left-0 before:top-[0.8em] before:h-px before:w-3 before:bg-moon">
                                            {h}
                                        </li>
                                    ))}
                                </ul>
                                <ul class="mt-6 flex flex-wrap gap-2">
                                    {r.technologies.map((t) => (
                                        <li class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-xs font-mono text-[#c5cbd6]">
                                            {t}
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        ))}
                    </div>
                </article>
            );
        })
    }
</div>
