---
// Proposal C: impact dashboard on top, compact company cards with collapsible roles (no JS).
import {
    DEMO_EXPERIENCE,
    formatMonth,
    tenure,
} from "../../../utils/experience-demo";

interface Props {
    lang: string;
}
const { lang } = Astro.props;
const es = lang === "es";
const present = es ? "Actualidad" : "Present";
const key = es ? "es" : "en";

const earliest = DEMO_EXPERIENCE.flatMap((c) => c.roles)
    .map((r) => r.start)
    .sort()[0];
const kpis = [
    {
        value: tenure(earliest, "Present", lang),
        label: es ? "de experiencia profesional" : "of professional experience",
    },
    {
        value: DEMO_EXPERIENCE[1].metrics[0].value,
        label: DEMO_EXPERIENCE[1].metrics[0].label[key],
    },
    {
        value: DEMO_EXPERIENCE[1].metrics[2].value,
        label: DEMO_EXPERIENCE[1].metrics[2].label[key],
    },
    {
        value: DEMO_EXPERIENCE[0].metrics[0].value,
        label: DEMO_EXPERIENCE[0].metrics[0].label[key],
    },
];
---

<section aria-label={es ? "Resumen de impacto" : "Impact summary"}>
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
        {
            kpis.map((k) => (
                <div class="glass-card rounded-2xl p-5">
                    <dd class="font-heading text-2xl md:text-3xl font-bold text-moon leading-none">
                        {k.value}
                    </dd>
                    <dt class="mt-2 text-sm text-[#a3a3ad] leading-5">
                        {k.label}
                    </dt>
                </div>
            ))
        }
    </dl>
</section>

<div class="mt-10 space-y-6">
    {
        DEMO_EXPERIENCE.map((c) => {
            const first = c.roles[c.roles.length - 1];
            const last = c.roles[0];
            return (
                <article class="glass-card rounded-2xl p-5 md:p-7">
                    <header class="flex flex-wrap items-center gap-x-4 gap-y-2">
                        <div class="shrink-0 w-11 h-11 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center">
                            <span
                                class="font-heading text-xl font-bold text-moon"
                                aria-hidden="true"
                            >
                                {c.company.charAt(0)}
                            </span>
                        </div>
                        <div class="flex-1 min-w-[12rem]">
                            <h2 class="font-heading text-xl md:text-2xl font-bold text-light">
                                {c.company}
                            </h2>
                            <p class="text-sm text-[#a3a3ad]">
                                {c.context[key]}
                            </p>
                        </div>
                        <p class="text-sm font-mono text-[#a3a3ad]">
                            {formatMonth(first.start, lang)}
                            {" – "}
                            {last.end === "Present"
                                ? present
                                : formatMonth(last.end, lang)}
                            <span class="text-moon">
                                {" · "}
                                {tenure(first.start, last.end, lang)}
                            </span>
                        </p>
                    </header>

                    <div class="mt-6 divide-y divide-white/10 border-t border-white/10">
                        {c.roles.map((r, i) => (
                            <details class="group py-4" open={i === 0}>
                                <summary class="flex items-center gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-moon">
                                    <svg
                                        class="h-4 w-4 shrink-0 text-moon transition-transform group-open:rotate-90"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                        aria-hidden="true"
                                    >
                                        <path d="M7 4l6 6-6 6V4z" />
                                    </svg>
                                    <span class="flex-1 font-heading text-base md:text-lg font-semibold text-light">
                                        {r.title}
                                    </span>
                                    <span class="text-xs md:text-sm font-mono text-[#a3a3ad]">
                                        {formatMonth(r.start, lang)}
                                        {" – "}
                                        {r.end === "Present"
                                            ? present
                                            : formatMonth(r.end, lang)}
                                    </span>
                                </summary>
                                <div class="mt-4 pl-7">
                                    <ul class="space-y-3 max-w-[68ch] text-[15px] leading-7 text-[#c5cbd6]">
                                        {r.highlights[key].map((h) => (
                                            <li class="relative pl-5 before:absolute before:left-0 before:top-[0.75em] before:h-1.5 before:w-1.5 before:rounded-full before:bg-moon/70">
                                                {h}
                                            </li>
                                        ))}
                                    </ul>
                                    <ul class="mt-4 flex flex-wrap gap-2">
                                        {r.technologies.map((t) => (
                                            <li class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-xs font-mono text-[#c5cbd6]">
                                                {t}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </details>
                        ))}
                    </div>
                </article>
            );
        })
    }
</div>
