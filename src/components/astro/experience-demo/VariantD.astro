---
// Proposal D (recommended): grouped timeline with a side rail (role, dates, stack) and a reading column.
import {
    DEMO_EXPERIENCE,
    boldMarkup,
    formatMonth,
    tenure,
} from "../../../utils/experience-demo";

interface Props {
    lang: string;
}
const { lang } = Astro.props;
const es = lang === "es";
const key = es ? "es" : "en";
const present = es ? "Actualidad" : "Present";
---

<ol class="space-y-8 md:space-y-10">
    {
        DEMO_EXPERIENCE.map((c) => {
            const first = c.roles[c.roles.length - 1];
            const last = c.roles[0];
            return (
                <li>
                    <article class="glass-card rounded-2xl p-5 sm:p-7 lg:p-9">
                        <header class="flex flex-col gap-4 sm:flex-row sm:items-center pb-6 border-b border-white/10">
                            <div class="shrink-0 h-12 w-32 rounded-lg bg-[#f4f4f5] flex items-center justify-center px-3">
                                <img
                                    src={c.logo}
                                    alt=""
                                    height="24"
                                    class="max-h-6 w-full object-contain"
                                />
                            </div>
                            <div class="flex-1 min-w-0">
                                <h2 class="font-heading text-2xl md:text-3xl font-bold text-light flex flex-wrap items-baseline gap-x-3">
                                    {c.company}
                                    <span class="text-sm font-sans font-medium text-moon">
                                        {c.kind[key]}
                                    </span>
                                </h2>
                                <p class="mt-1 text-sm md:text-base text-[#a3a3ad]">
                                    {c.context[key]} · {c.location}
                                </p>
                            </div>
                            <p class="text-sm font-mono text-[#a3a3ad] sm:text-right shrink-0">
                                <time datetime={first.start}>
                                    {formatMonth(first.start, lang)}
                                </time>
                                {" – "}
                                {last.end === "Present" ? (
                                    present
                                ) : (
                                    <time datetime={last.end}>
                                        {formatMonth(last.end, lang)}
                                    </time>
                                )}
                                <span class="block text-moon">
                                    {tenure(first.start, last.end, lang)}
                                </span>
                            </p>
                        </header>

                        <ol class="mt-8 ml-1.5 border-l border-white/10 space-y-12">
                            {c.roles.map((r, i) => (
                                <li class="relative pl-6 md:pl-9 grid gap-x-10 gap-y-4 lg:grid-cols-[250px_minmax(0,1fr)]">
                                    <span
                                        class={`absolute -left-[7px] top-2 h-3.5 w-3.5 rounded-full border-2 border-gunmetal ${i === 0 ? "bg-moon" : "bg-wolf"}`}
                                        aria-hidden="true"
                                    />
                                    <div>
                                        <h3 class="font-heading text-lg md:text-xl font-semibold text-light leading-snug">
                                            {r.title}
                                        </h3>
                                        <p class="mt-1 text-sm font-mono text-[#a3a3ad]">
                                            <time datetime={r.start}>
                                                {formatMonth(r.start, lang)}
                                            </time>
                                            {" – "}
                                            {r.end === "Present" ? (
                                                present
                                            ) : (
                                                <time datetime={r.end}>
                                                    {formatMonth(r.end, lang)}
                                                </time>
                                            )}
                                            <span class="text-moon">
                                                {" · "}
                                                {tenure(r.start, r.end, lang)}
                                            </span>
                                        </p>
                                        <ul class="mt-4 flex flex-wrap gap-2">
                                            {r.technologies.map((t) => (
                                                <li class="px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-xs font-mono text-[#c5cbd6]">
                                                    {t}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="max-w-[68ch] text-base md:text-lg font-medium leading-7 text-light">
                                            {r.summary[key]}
                                        </p>
                                        <ul class="mt-4 space-y-3 max-w-[68ch] text-[15px] md:text-base leading-7 text-[#c5cbd6]">
                                            {r.highlights[key].map((h) => (
                                                <li
                                                    class="relative pl-5 before:absolute before:left-0 before:top-[0.75em] before:h-1.5 before:w-1.5 before:rounded-full before:bg-moon/70"
                                                    set:html={boldMarkup(h)}
                                                />
                                            ))}
                                        </ul>
                                    </div>
                                </li>
                            ))}
                        </ol>
                    </article>
                </li>
            );
        })
    }
</ol>
