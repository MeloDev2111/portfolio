---
import { getCollection, type CollectionEntry } from "astro:content";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import CertCard from "../ui/CertCard.astro";
import {
    getLangFromUrl,
    useTranslations,
    getRelativeLocaleUrl,
} from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type CertEntry = CollectionEntry<"certifications">;
const certifications = await getCollection("certifications");
---

<Section id="certifications" tone="subtle" width="full" space="md">
    <SectionHeading
        title={t("nav.certifications")}
        accent={t("nav.certifications")}
        rule
        action={{
            href: getRelativeLocaleUrl(lang, "certifications"),
            label: t("section.viewAllCerts"),
        }}
        class="mb-12"
    />

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
            certifications
                .filter((c) => c.data.starred)
                .sort(
                    (a, b) =>
                        new Date(b.data.date).valueOf() -
                        new Date(a.data.date).valueOf(),
                )
                .slice(0, 4)
                .map((cert: CertEntry) => (
                    <CertCard
                        name={cert.data.name}
                        issuer={cert.data.issuer}
                        date={cert.data.date}
                        url={cert.data.url}
                        badgeSrc={
                            cert.data.badge
                                ? cert.data.badge.startsWith("http")
                                    ? cert.data.badge
                                    : import.meta.env.BASE_URL.replace(
                                          /\/$/,
                                          "",
                                      ) + cert.data.badge
                                : undefined
                        }
                    />
                ))
        }
    </div>
</Section>
