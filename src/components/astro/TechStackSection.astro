---
import TechStack from "./TechStack.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import {
    getLangFromUrl,
    useTranslations,
    getRelativeLocaleUrl,
} from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="tech-stack" tone="base" width="full" space="md">
    <SectionHeading
        title={t("nav.tech")}
        accent={t("nav.tech")}
        rule
        action={{
            href: getRelativeLocaleUrl(lang, "tech-stack"),
            label: t("section.viewFullTech"),
        }}
        class="mb-12"
    />
    <TechStack compact={true} />
</Section>
