---
import { Image } from "astro:assets";
import Card from "./Card.astro";

interface Props {
    name: string;
    issuer: string;
    date: string;
    url: string;
    badgeSrc?: string;
}

const { name, issuer, date, url, badgeSrc } = Astro.props;
---

<Card
    as="a"
    href={url}
    external
    variant="glass"
    radius="bento"
    pad="sm"
    interactive
    glow
    noise
    class="group flex h-full flex-col items-center justify-between gap-6 overflow-hidden text-center"
>
    <div
        class="relative z-10 flex h-20 w-20 items-center justify-center rounded-full border border-border bg-surface-raised p-3 transition-all duration-300 group-hover:border-border-accent group-hover:bg-accent-surface"
    >
        {
            badgeSrc ? (
                <Image
                    src={badgeSrc}
                    alt={name}
                    width={80}
                    height={80}
                    loading="lazy"
                    class="h-full w-full object-contain drop-shadow-lg transition-transform duration-500 group-hover:scale-110"
                />
            ) : (
                <span class="text-3xl">🏅</span>
            )
        }
    </div>

    <div class="relative z-10 flex flex-grow flex-col items-center text-center">
        <h3
            class="mb-2 font-heading text-lg font-bold leading-tight text-fg-strong transition-colors group-hover:text-accent"
        >
            {name}
        </h3>
        <p
            class="mb-4 w-full border-b border-border pb-2 text-xs font-bold tracking-wider text-fg-muted"
        >
            {issuer}
        </p>
        <p class="mt-auto font-mono text-[10px] tracking-widest text-fg-subtle">
            {date}
        </p>
    </div>

    <div
        class="absolute bottom-0 left-0 h-1 w-full origin-left scale-x-0 bg-accent transition-transform duration-500 group-hover:scale-x-100"
    >
    </div>
</Card>
