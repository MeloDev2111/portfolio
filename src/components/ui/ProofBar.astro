---
import { getBentoSkills } from "../../utils/skills";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { siteConfig } from "../../site.config";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Main stack + clouds, no derived metrics — see docs/ROADMAP.md.
const coreStack = getBentoSkills().filter(
    (skill) => skill.category === "Backend" || skill.category === "Cloud",
);
---

<div
    class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 border-y border-border bg-bg-subtle px-4 py-6"
>
    <div class="flex items-center gap-4">
        {
            coreStack.map((skill) => (
                <img
                    src={skill.icon}
                    alt={skill.name}
                    title={skill.name}
                    class="h-7 w-7 object-contain opacity-70 grayscale transition-all hover:opacity-100 hover:grayscale-0"
                />
            ))
        }
    </div>

    <span class="hidden h-6 w-px bg-border sm:block" aria-hidden="true"></span>

    <p class="flex items-center gap-2 text-sm font-medium text-fg-muted">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 text-accent"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        {siteConfig.location} &middot; {t("proof.remote")}
    </p>
</div>
