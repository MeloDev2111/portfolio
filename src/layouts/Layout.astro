---
import "../styles/global.css";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";
import LanguageToast from "../components/astro/LanguageToast.astro";
import ScrollToTop from "../components/astro/ScrollToTop.astro";
import { getLangFromUrl } from "../i18n/utils";
import { siteConfig } from "../site.config";
import { languages } from "../i18n/ui";
import { USER_SOCIALS } from "../utils/social";

interface Props {
    title: string;
    description?: string;
    lang?: string;
    noindex?: boolean;
}

const {
    title,
    description = siteConfig.description,
    lang = getLangFromUrl(Astro.url),
    noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = Astro.site ?? new URL(siteConfig.url);
// Canonical: absolute URL without query string or hash.
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(base + siteConfig.ogImage, site).href;

// hreflang alternates: swap the locale segment of the current path.
const localeCodes = Object.keys(languages);
const pathNoBase = Astro.url.pathname.slice(base.length);
const [, firstSegment, ...restSegments] = pathNoBase.split("/");
const isLocalized = localeCodes.includes(firstSegment);
const alternates = isLocalized
    ? localeCodes.map((code) => ({
          code,
          href: new URL(`${base}/${[code, ...restSegments].join("/")}`, site)
              .href,
      }))
    : [];
const defaultAlternate = alternates.find((a) => a.code === "en");

const ogLocales: Record<string, string> = {
    en: "en_US",
    es: "es_PE",
    ja: "ja_JP",
};

const personJsonLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${site.origin}/#person`,
    name: siteConfig.name,
    alternateName: siteConfig.alias,
    url: site.origin,
    jobTitle: siteConfig.role,
    description: siteConfig.description,
    image: ogImageUrl,
    address: {
        "@type": "PostalAddress",
        addressCountry: "PE",
    },
    sameAs: USER_SOCIALS.filter(
        (s) =>
            !s.disabled && !s.excludeFromSameAs && s.url.startsWith("https://"),
    ).map((s) => s.url),
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        {noindex && <meta name="robots" content="noindex" />}
        <link
            rel="icon"
            href={import.meta.env.BASE_URL.replace(/\/$/, "") + "/favicon.ico"}
            sizes="48x48"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href={import.meta.env.BASE_URL.replace(/\/$/, "") + "/favicon.svg"}
        />
        <link
            rel="apple-touch-icon"
            href={import.meta.env.BASE_URL.replace(/\/$/, "") +
                "/apple-touch-icon.png"}
        />
        <link
            rel="sitemap"
            href={import.meta.env.BASE_URL.replace(/\/$/, "") +
                "/sitemap-index.xml"}
        />
        <meta name="generator" content={Astro.generator} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <!-- Discord / Theme -->
        <meta name="theme-color" content={siteConfig.theme.colors.primary} />

        <!-- SEO / Open Graph -->
        <title>{title}</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:site_name" content={siteConfig.name} />
        <meta property="og:locale" content={ogLocales[lang] ?? "en_US"} />
        {
            localeCodes
                .filter((code) => code !== lang)
                .map((code) => (
                    <meta
                        property="og:locale:alternate"
                        content={ogLocales[code]}
                    />
                ))
        }
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={siteConfig.ogImageAlt} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalUrl} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={siteConfig.ogImageAlt} />

        <!-- Canonical & language alternates -->
        <link rel="canonical" href={canonicalUrl} />
        {
            alternates.map((a) => (
                <link rel="alternate" hreflang={a.code} href={a.href} />
            ))
        }
        {
            defaultAlternate && (
                <link
                    rel="alternate"
                    hreflang="x-default"
                    href={defaultAlternate.href}
                />
            )
        }

        <!-- Structured data -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(personJsonLd)}
        />
    </head>
    <body
        class="bg-gunmetal text-light font-sans antialiased text-base selection:bg-moon selection:text-gunmetal min-h-screen flex flex-col"
    >
        <LanguageToast />
        <Header />
        <main class="flex-grow pt-16">
            <slot />
        </main>
        <Footer />
        <ScrollToTop />
    </body>
</html>
