---
import "../styles/global.css";
import { ClientRouter, fade } from "astro:transitions";
import ThemeScript from "./ThemeScript.astro";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";
import LanguageToast from "../components/astro/LanguageToast.astro";
import ScrollToTop from "../components/astro/ScrollToTop.astro";
import { getLangFromUrl } from "../i18n/utils";
import { siteConfig } from "../site.config";
import { THEME_COLOR } from "../utils/theme";

interface Props {
    title: string;
    description?: string;
    lang?: string;
}

const {
    title,
    description = siteConfig.description,
    lang = getLangFromUrl(Astro.url),
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <ThemeScript />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark light" />
        <link
            rel="icon"
            type="image/svg+xml"
            href={import.meta.env.BASE_URL.replace(/\/$/, "") + "/favicon.svg"}
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="generator" content={Astro.generator} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <!-- Theme color: page background, updated per-theme by ThemeScript/ThemeToggle -->
        <meta name="theme-color" content={THEME_COLOR.dark} />

        <!-- SEO / Open Graph -->
        <title>{title}</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta
            property="og:image"
            content={new URL(siteConfig.ogImage, Astro.site)}
        />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta
            property="twitter:image"
            content={new URL(siteConfig.ogImage, Astro.site)}
        />

        <!-- Canonical -->
        <link rel="canonical" href={Astro.url} />

        <ClientRouter />
    </head>
    <body
        class="bg-bg text-fg font-sans antialiased text-base selection:bg-accent selection:text-accent-fg min-h-screen flex flex-col"
    >
        <LanguageToast />
        <Header transition:persist />
        <main
            class="flex-grow pt-20"
            transition:animate={fade({ duration: "0.2s" })}
        >
            <slot />
        </main>
        <Footer />
        <ScrollToTop />

        <script>
            import { initReveal } from "../utils/reveal";
            document.addEventListener("astro:page-load", () => initReveal());
        </script>
    </body>
</html>
